# Configuració de l'Agent de Reg dels Canals d'Urgell
# Copieu aquest fitxer a .env i configureu les vostres claus

# API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENWEATHER_API_KEY=3757fa44bafaa3c1964279b3ceefb592
GEMINI_API_KEY=AIzaSy...

# Llindars hidrològics (opcionals)
LLINDAR_NORMALITAT=50.0
LLINDAR_PREALERTA=35.0
LLINDAR_ALERTA=20.0
LLINDAR_EMERGENCIA=10.0

# Factor de reducció en mode sequera (0-1)
FACTOR_SEQUERA=0.60

# Llindar de pluja per posposar reg (mm en 24h)
LLINDAR_PLUJA_POSPOSAR=5.0
